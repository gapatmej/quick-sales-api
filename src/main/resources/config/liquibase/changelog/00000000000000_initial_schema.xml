<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="00000000000000" author="jhipster">
        <createSequence sequenceName="sequence_generator" startValue="1050" incrementBy="50"/>
    </changeSet>

    <!--
        JHipster core tables.
        The initial schema has the '00000000000001' id, so that it is over-written if we re-generate it.
    -->
    <changeSet id="00000000000001" author="jhipster">
        <createTable tableName="organization">
            <column name="id" type="bigint" >
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="identification_type" type="varchar(20)">
                <constraints nullable="false" />
            </column>
            <column name="identification" type="varchar(13)">
                <constraints nullable="false" />
            </column>
            <column name="business_name" type="varchar(200)">
                <constraints nullable="false" />
            </column>
            <column name="tradename" type="varchar(200)">
                <constraints nullable="false" />
            </column>
            <column name="address" type="varchar(200)">
                <constraints nullable="false" />
            </column>
            <column name="phone" type="varchar(13)"/>
            <column name="mobile_phone" type="varchar(13)"/>
            <column name="special_taxpayer_number" type="numeric"/>
            <column name="keep_accounting" type="boolean">
                <constraints nullable="false" />
            </column>
            <column name="logo" type="varchar(200)"/>
            <column name="token" type="varchar(20)">
                <constraints nullable="false" />
            </column>
            <column name="mail" type="varchar(100)">
                <constraints nullable="false" />
            </column>
            <column name="sri_environment" type="varchar(20)">
                <constraints nullable="false" />
            </column>
            <column name="emission_type" type="varchar(10)">
                <constraints nullable="false" />
            </column>
            <column name="certificate_file_name" type="varchar(50)">
                <constraints nullable="false" />
            </column>
            <column name="certificate_password" type="varchar(30)">
                <constraints nullable="false" />
            </column>
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>

        <createTable tableName="branch_office">
            <column name="id" type="bigint" >
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="organization_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="business_name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="varchar(13)"/>
            <column name="mobile_phone" type="varchar(13)"/>
            <column name="establishment_code" type="varchar(3)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="active" type="boolean">
                <constraints nullable="false" />
            </column>
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="organization_id"
                                 baseTableName="branch_office"
                                 constraintName="fk_organization_id"
                                 referencedColumnNames="id"
                                 referencedTableName="organization"/>

        <createTable tableName="emission_point">
            <column name="id" type="bigint" >
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="branch_office_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="emission_point_code" type="varchar(3)">
                <constraints nullable="false" />
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="branch_office_id"
                                 baseTableName="emission_point"
                                 constraintName="fk_branch_office_id"
                                 referencedColumnNames="id"
                                 referencedTableName="branch_office"/>

        <addUniqueConstraint tableName="emission_point" columnNames="branch_office_id, emission_point_code"/>

        <createTable tableName="jhi_user">
            <column name="id" type="bigint" >
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="identification" type="varchar(13)">
                <constraints nullable="false" />
            </column>
            <column name="password_hash" type="varchar(60)"/>
            <column name="first_name" type="varchar(50)"/>
            <column name="last_name" type="varchar(50)"/>
            <column name="email" type="varchar(100)">
                <constraints unique="true" uniqueConstraintName="ux_user_email"/>
            </column>
            <column name="phone" type="varchar(13)"/>
            <column name="activated" type="boolean" valueBoolean="false">
                <constraints nullable="false" />
            </column>
            <column name="lang_key" type="varchar(10)"/>
            <column name="image_url" type="varchar(200)"/>
            <column name="activation_key" type="varchar(20)"/>
            <column name="reset_key" type="varchar(20)"/>
            <column name="reset_date" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>

        <addNotNullConstraint   columnName="password_hash"
                                columnDataType="varchar(60)"
                                tableName="jhi_user"/>

        <createTable tableName="jhi_authority">
            <column name="id" type="bigint" >
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="organization_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(200)"/>
            <column name="active" type="boolean">
                <constraints nullable="false" />
            </column>
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="organization_id"
                                 baseTableName="jhi_authority"
                                 constraintName="fk_organization_id"
                                 referencedColumnNames="id"
                                 referencedTableName="organization"/>

        <createTable tableName="jhi_user_authority">
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="authority_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="user_id, authority_id" tableName="jhi_user_authority"/>

        <addForeignKeyConstraint baseColumnNames="authority_id"
                                 baseTableName="jhi_user_authority"
                                 constraintName="fk_authority_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_authority"/>

        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="jhi_user_authority"
                                 constraintName="fk_user_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"/>

        <createTable tableName="jhi_user_organization">
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="organization_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="user_id, organization_id" tableName="jhi_user_organization"/>

        <addForeignKeyConstraint baseColumnNames="organization_id"
                                 baseTableName="jhi_user_organization"
                                 constraintName="fk_organization_id"
                                 referencedColumnNames="id"
                                 referencedTableName="organization"/>

        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="jhi_user_organization"
                                 constraintName="fk_user_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"/>

        <createTable tableName="jhi_user_branch_office">
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="branch_office_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="user_id, branch_office_id" tableName="jhi_user_branch_office"/>

        <addForeignKeyConstraint baseColumnNames="branch_office_id"
                                 baseTableName="jhi_user_branch_office"
                                 constraintName="fk_branch_office_id"
                                 referencedColumnNames="id"
                                 referencedTableName="branch_office"/>

        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="jhi_user_branch_office"
                                 constraintName="fk_user_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"/>

        <createTable tableName="jhi_permit">
            <column name="id" type="bigint" >
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="organization_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="resource" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="organization_id"
                                 baseTableName="jhi_permit"
                                 constraintName="fk_organization_id"
                                 referencedColumnNames="id"
                                 referencedTableName="organization"/>

        <createTable tableName="jhi_authority_permit">
            <column name="authority_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="permit_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="authority_id, permit_id" tableName="jhi_authority_permit"/>

        <addForeignKeyConstraint baseColumnNames="authority_id"
                                 baseTableName="jhi_authority_permit"
                                 constraintName="fk_authority_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_authority"/>

        <addForeignKeyConstraint baseColumnNames="permit_id"
                                 baseTableName="jhi_authority_permit"
                                 constraintName="fk_permit_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_permit"/>

        <loadData
            file="config/liquibase/data/organization.csv"
            separator=";"
            tableName="organization">
            <column name="id" type="numeric"/>
            <column name="special_taxpayer_number" type="numeric"/>
            <column name="keep_accounting" type="boolean"/>
            <column name="activated" type="boolean"/>
            <column name="created_date" type="timestamp"/>
        </loadData>

        <loadData
            file="config/liquibase/data/branch_office.csv"
            separator=";"
            tableName="branch_office">
            <column name="id" type="numeric"/>
            <column name="organization_id" type="numeric"/>
            <column name="active" type="boolean"/>
            <column name="created_date" type="timestamp"/>
        </loadData>

        <loadData
            file="config/liquibase/data/emission_point.csv"
            separator=";"
            tableName="emission_point">
            <column name="id" type="numeric"/>
            <column name="branch_office_id" type="numeric"/>
            <column name="created_date" type="timestamp"/>
            <column name="last_modified_date" type="timestamp"/>
        </loadData>

        <loadData
            file="config/liquibase/data/user.csv"
            separator=";"
            tableName="jhi_user">
            <column name="id" type="numeric"/>
            <column name="organization_id" type="numeric"/>
            <column name="activated" type="boolean"/>
            <column name="created_date" type="timestamp"/>
        </loadData>
        <dropDefaultValue tableName="jhi_user" columnName="created_date" columnDataType="datetime"/>
        <loadData
            file="config/liquibase/data/authority.csv"
            separator=";"
            tableName="jhi_authority">
            <column name="id" type="numeric"/>
            <column name="organization_id" type="numeric"/>
            <column name="active" type="boolean"/>
        </loadData>

        <loadData
            file="config/liquibase/data/user_authority.csv"
            separator=";"
            tableName="jhi_user_authority">
            <column name="user_id" type="numeric"/>
            <column name="authority_id" type="numeric"/>
        </loadData>

        <loadData
            file="config/liquibase/data/user_organization.csv"
            separator=";"
            tableName="jhi_user_organization">
            <column name="user_id" type="numeric"/>
            <column name="organization_id" type="numeric"/>
        </loadData>

        <loadData
            file="config/liquibase/data/user_branch_office.csv"
            separator=";"
            tableName="jhi_user_branch_office">
            <column name="user_id" type="numeric"/>
            <column name="branch_office_id" type="numeric"/>
        </loadData>

        <loadData
            file="config/liquibase/data/permit.csv"
            separator=";"
            tableName="jhi_permit">
            <column name="id" type="numeric"/>
            <column name="organization_id" type="numeric"/>
        </loadData>

        <loadData
            file="config/liquibase/data/authority_permit.csv"
            separator=";"
            tableName="jhi_authority_permit">
            <column name="authority_id" type="numeric"/>
            <column name="permit_id" type="numeric"/>
        </loadData>

        <createTable tableName="jhi_persistent_audit_event">
            <column name="event_id" type="bigint" >
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="principal" type="varchar(50)">
                <constraints nullable="false" />
            </column>
            <column name="event_date" type="timestamp"/>
            <column name="event_type" type="varchar(255)"/>
        </createTable>

        <createTable tableName="jhi_persistent_audit_evt_data">
            <column name="event_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="value" type="varchar(255)"/>
        </createTable>
        <addPrimaryKey columnNames="event_id, name" tableName="jhi_persistent_audit_evt_data"/>

        <createIndex indexName="idx_persistent_audit_event"
                     tableName="jhi_persistent_audit_event"
                     unique="false">
            <column name="principal" type="varchar(50)"/>
            <column name="event_date" type="timestamp"/>
        </createIndex>

        <createIndex indexName="idx_persistent_audit_evt_data"
                     tableName="jhi_persistent_audit_evt_data"
                     unique="false">
            <column name="event_id" type="bigint"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="event_id"
                                 baseTableName="jhi_persistent_audit_evt_data"
                                 constraintName="fk_evt_pers_audit_evt_data"
                                 referencedColumnNames="event_id"
                                 referencedTableName="jhi_persistent_audit_event"/>
    </changeSet>

    <changeSet author="jhipster" id="00000000000002" context="test">
        <createTable tableName="jhi_date_time_wrapper">
            <column  name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="jhi_date_time_wrapperPK"/>
            </column>
            <column name="instant" type="timestamp"/>
            <column name="local_date_time" type="timestamp"/>
            <column name="offset_date_time" type="timestamp"/>
            <column name="zoned_date_time" type="timestamp"/>
            <column name="local_time" type="time"/>
            <column name="offset_time" type="time"/>
            <column name="local_date" type="date"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
