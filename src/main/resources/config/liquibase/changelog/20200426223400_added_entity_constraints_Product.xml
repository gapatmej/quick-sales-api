        <addForeignKeyConstraint baseColumnNames="sub_category_id"
                                 baseTableName="product"
                                 constraintName="fk_product_sub_category_id"
                                 referencedColumnNames="id"
                                 referencedTableName="sub_category"/>

        <addForeignKeyConstraint baseColumnNames="cellar_id"
                                 baseTableName="product"
                                 constraintName="fk_product_cellar_id"
                                 referencedColumnNames="id"
                                 referencedTableName="cellar"/>

    </changeSet>
</databaseChangeLog>
