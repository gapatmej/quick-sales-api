<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">
    <!--
        Added the constraints for entity Payment.
    -->
    <changeSet id="20200426223600-2" author="jhipster">
        
        <addForeignKeyConstraint baseColumnNames="way_pay_id"
                                 baseTableName="payment"
                                 constraintName="fk_payment_way_pay_id"
                                 referencedColumnNames="id"
                                 referencedTableName="pay_way"/>

        <addForeignKeyConstraint baseColumnNames="invoice_id"
                                 baseTableName="payment"
                                 constraintName="fk_payment_invoice_id"
                                 referencedColumnNames="id"
                                 referencedTableName="invoice_client"/>

    </changeSet>
</databaseChangeLog>
